# Senha que a Pamela usa para entrar no modo de edicao (/editar)
ADMIN_PASSWORD=troque-esta-senha

# Opcional: segredo para assinar o cookie de sessao (se vazio, usa ADMIN_PASSWORD)
SESSION_SECRET=

# Criado automaticamente pela Vercel ao conectar um Blob Store ao projeto.
# Sem ele, em desenvolvimento local, paginas e fotos ficam na pasta .data/
BLOB_READ_WRITE_TOKEN=
